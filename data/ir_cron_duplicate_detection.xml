<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_detect_duplicates_cron_server" model="ir.actions.server">
        <field name="name">Detecter les doublons (cron)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.action_detect_duplicates_cron()</field>
        <field name="usage">ir_cron</field>
    </record>

    <record id="ir_cron_detect_duplicates" model="ir.cron">
        <field name="ir_actions_server_id" ref="action_detect_duplicates_cron_server"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
</odoo>